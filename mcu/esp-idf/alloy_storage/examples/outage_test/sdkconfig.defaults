# Wi-Fi + TLS + HTTP needs more than the 1 MB default app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# lwIP waits a random 0..5 s before its first SNTP request by default, which often loses the
# SDK's 5 s SNTP grace to the HTTP Date fallback. 0..1 s keeps SNTP the usual clock source.
CONFIG_LWIP_SNTP_MAXIMUM_STARTUP_DELAY=1000
