menu "Outage test"

    config EXAMPLE_WIFI_SSID
        string "Wi-Fi SSID (2.4 GHz)"
        default "YOUR_2_4_GHZ_WIFI_NAME"

    config EXAMPLE_WIFI_PASSWORD
        string "Wi-Fi password"
        default "YOUR_WIFI_PASSWORD"

    config EXAMPLE_ALLOY_API_KEY
        string "Alloy device key"
        default "YOUR_ALLOY_DEVICE_KEY"
        help
            This robot's own Alloy device key, never the org API key. Keep it out of version control: put it in a
            gitignored sdkconfig file, never in sdkconfig.defaults.

    config EXAMPLE_ALLOY_MESH_PATH
        string "Mesh path"
        default "tests/esp32-outage"
        help
            Letters, numbers, _, - and / only, 1-128 characters, no leading or trailing slash.

    config EXAMPLE_OUTAGE_SECONDS
        int "Wi-Fi outage length (s)"
        default 25

    config EXAMPLE_RUN_SECONDS
        int "Total logging time (s)"
        default 60

    config EXAMPLE_INGEST_URL
        string "Ingest URL (empty: component default)"
        default ""

endmenu
